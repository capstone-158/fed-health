# full real data, paper settings (needs data/val.pt + data/test.pt: make_data_modes.py --full-eval)
DATA_DIR=./data
H0_MODEL=alexnet
H1_MODEL=resnet
H2_MODEL=net
ROUNDS=10
EPOCHS=20
# paper uses 128 on a V100; on a laptop CPU drop this like small.env if nodes get OOM-killed
BATCH_SIZE=128
MICRO_BATCH=128
# rounds take hours on full shards
ROUND_TIMEOUT=36000
