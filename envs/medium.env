# paper hyperparameters (SGD, lr 0.001, batch 128) on 25% of each real shard, fewer rounds/epochs,
# evaluated on the FULL val (7,180) / test (10,004). build with: make_data_modes.py --full-eval --medium
DATA_DIR=./data/medium
H0_MODEL=alexnet
H1_MODEL=resnet
H2_MODEL=net
ROUNDS=10
EPOCHS=20
# effective batch 128 like the paper, run as 4 x 32 with gradient accumulation so it fits in docker memory
BATCH_SIZE=128
MICRO_BATCH=32
# a ResNet round on CPU takes ~80 min; extra margin in case the machine is slowed or paused
ROUND_TIMEOUT=14400
