# small slice of the real PathMNIST data with the paper's 3 models (build with make_data_modes.py)
DATA_DIR=./data/small
H0_MODEL=alexnet
H1_MODEL=resnet
H2_MODEL=net
ROUNDS=10
EPOCHS=20
# paper: lr 0.001 (shared/config.py), 20 epochs, batch 128.
# batch 128 runs as 4 x 32 with gradient accumulation so 6 nodes fit in docker memory
BATCH_SIZE=128
MICRO_BATCH=32
# 20 epochs of ResNet/Net on CPU take well over the default 10 min per round
ROUND_TIMEOUT=14400
# twin trust experiments: TWIN_TRUST on/off, ATTACK none | label_flip | poison | free_ride | inflate
TWIN_TRUST=off
ATTACK=none
ATTACK_NODE=1
