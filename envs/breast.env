# BreakHis breast tumour dataset (paper's second dataset), 2 classes, paper settings.
# build the data first: python3 side_shit/make_data_modes.py --breast-only
# run on the GPU:       python3 run_native.py envs/breast.env
DATA_DIR=./data/breast
NUM_CLASSES=2
H0_MODEL=alexnet
H1_MODEL=resnet
H2_MODEL=net
ROUNDS=10
EPOCHS=20
BATCH_SIZE=128
MICRO_BATCH=128
ROUND_TIMEOUT=36000
